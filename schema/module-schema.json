{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LiftOff Module",
  "description": "Schema for a LiftOff community learning module",
  "type": "object",
  "required": ["id", "title", "description", "color", "icon", "lessons"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case identifier for the module"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "Human-readable title shown in the UI"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "description": "Markdown-formatted description of the module"
    },
    "gettingStarted": {
      "type": "string",
      "description": "Markdown content shown in the Getting Started panel"
    },
    "gettingStartedTitle": {
      "type": "string",
      "description": "Title for the Getting Started panel"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "Hex color code for the module card"
    },
    "icon": {
      "type": "string",
      "description": "Emoji icon for the module"
    },
    "private": {
      "type": "boolean",
      "default": false,
      "description": "If true, module is hidden from public listing"
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Lesson" },
      "description": "Ordered list of lessons in the module"
    }
  },
  "definitions": {
    "Lesson": {
      "type": "object",
      "required": ["id", "slug", "title", "partNumber", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^lesson-[0-9]+-",
          "description": "Unique lesson ID, e.g. lesson-1-my-lesson"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "URL-safe slug for the lesson"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "partNumber": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Step" }
        }
      }
    },
    "Step": {
      "type": "object",
      "required": ["id", "stepNumber", "title", "description", "points", "validatorId"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^step-[0-9]+-",
          "description": "Unique step ID, e.g. step-1-do-something"
        },
        "stepNumber": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "validatorId": {
          "type": "string",
          "pattern": "^validate-[a-z0-9-]+$",
          "description": "ID that maps to a validator function"
        },
        "manual": {
          "type": "boolean",
          "default": false,
          "description": "If true, step is validated by self-report rather than API check"
        },
        "inputField": {
          "$ref": "#/definitions/InputField"
        }
      }
    },
    "InputField": {
      "type": "object",
      "required": ["key", "label"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "label": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        }
      }
    }
  }
}
